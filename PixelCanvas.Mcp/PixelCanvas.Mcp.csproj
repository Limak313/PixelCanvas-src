<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 无头 MCP 宿主：跨平台，只依赖 Core；实时画布工具通过命名管道连接 Windows 桌面宿主。 -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PixelCanvas.Mcp</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PixelCanvas.Core/PixelCanvas.Core.csproj" />
    <InternalsVisibleTo Include="PixelCanvas.Tests" />
    <InternalsVisibleTo Include="PixelCanvas.Core.Tests" />
  </ItemGroup>
</Project>
